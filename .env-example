PORT=3000
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=six-cities
SALT=replace-with-your-random-string

# MongoDB и вход в mongo-express (только локальная разработка).
# Используйте латинские буквы и цифры, чтобы пароль подходил для URI.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-your-random-password
